{
  "info": {
    "name": "Professionals Task — Планировщик личных задач",
    "description": "Коллекция для проверки API отборочного задания чемпионата «Профессионалы», компетенция «Программные решения для бизнеса».\n\nКак пользоваться: выберите Environment `Local` (или создайте свой), укажите адрес своего сервера в переменной `baseUrl`, выполните запрос **Auth / Register**, затем **Auth / Login** — токен сохранится в переменную `token` автоматически. После этого остальные запросы будут уходить с заголовком `Authorization: Bearer {{token}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201 или 409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "pm.test('Единый формат ответа', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('success');",
                  "    pm.expect(pm.response.json()).to.have.property('data');",
                  "    pm.expect(pm.response.json()).to.have.property('message');",
                  "    pm.expect(pm.response.json()).to.have.property('error_code');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@college.ru\",\n  \"password\": \"SuperSecret123\",\n  \"fullName\": \"Иван Петров\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Токен получен и сохранён', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@college.ru\",\n  \"password\": \"SuperSecret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login — неверный пароль (401)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@college.ru\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Идентификатор сохранён', function () {",
                  "    pm.expect(body.data.id).to.not.be.undefined;",
                  "    pm.collectionVariables.set('taskId', body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Сделать ER-диаграмму\",\n  \"description\": \"Схема сущностей и связей\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-10-15\",\n  \"categoryId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "List tasks — все",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List tasks — фильтр и поиск",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=new&priority=high&q=ER&sort=dueDate&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "status", "value": "new" },
                { "key": "priority", "value": "high" },
                { "key": "q", "value": "ER" },
                { "key": "sort", "value": "dueDate" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get task by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Сделать ER-диаграмму (обновлено)\",\n  \"description\": \"Схема сущностей и связей\",\n  \"status\": \"in_progress\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"2026-10-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Complete task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"done\": true }"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "complete"]
            }
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tasks/summary", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "summary"] }
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Negative",
      "item": [
        {
          "name": "Create task без названия — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Без названия\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Без токена — 401",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Несуществующая задача — 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tasks/999999", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "999999"] }
          }
        },
        {
          "name": "Неверный приоритет — 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тест\",\n  \"priority\": \"critical\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        }
      ]
    }
  ]
}
